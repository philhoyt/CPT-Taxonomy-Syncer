{
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"yahnis-elsts/plugin-update-checker": "^5.3"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7",
		"phpcompatibility/phpcompatibility-wp": "*",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"phpmd/phpmd": "^2.15"
	},
	"scripts": {
		"copy-puc": "rsync -a --delete vendor/yahnis-elsts/plugin-update-checker/ lib/plugin-update-checker/",
		"post-install-cmd": "@copy-puc",
		"post-update-cmd": "@copy-puc",
		"lint": "phpcs",
		"lint-fix": "phpcbf",
		"mess": "phpmd cpt-taxonomy-syncer.php,uninstall.php,includes text phpmd.xml",
		"test": "phpunit"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4.99"
		}
	}
}
