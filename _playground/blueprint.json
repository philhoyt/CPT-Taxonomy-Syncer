{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "CPT-Taxonomy Syncer",
		"description": "Automatically syncs a custom post type with a taxonomy",
		"author": "philhoyt",
		"categories": [ "tools" ]
	},
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"login": true,
	"landingPage": "/wp-admin/tools.php?page=cpt-taxonomy-syncer",
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/philhoyt/CPT-Taxonomy-Syncer/releases/latest/download/cpt-taxonomy-syncer.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/philhoyt/cpt-taxonomy-syncer-demo/releases/latest/download/cpt-taxonomy-syncer-demo.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/philhoyt/CPT-Taxonomy-Syncer/main/_playground/demo-content.xml"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "CPT-Taxonomy Syncer Demo"
			}
		}
	]
}
