{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cpt-tax-syncer/previous-post-relationship",
	"version": "2.0.0",
	"title": "Previous Post (Relationship)",
	"category": "design",
	"icon": "arrow-left-alt2",
	"description": "Navigate to the previous post using custom relationship order.",
	"example": {},
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"relationshipPair": {
			"type": "string",
			"default": ""
		},
		"useCustomOrder": {
			"type": "boolean",
			"default": true
		},
		"linkText": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"textdomain": "cpt-taxonomy-syncer",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
