<?xml version="1.0"?>
<ruleset name="CPT-Taxonomy Syncer Mess Detection"
    xmlns="http://pmd.sf.net/ruleset/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Unused code, oversized units and naming for a WordPress project.</description>

    <rule ref="rulesets/unusedcode.xml">
        <!-- WordPress hook callbacks must accept every argument the filter passes; phpcs reports the rest -->
        <exclude name="UnusedFormalParameter"/>
    </rule>

    <rule ref="rulesets/codesize.xml">
        <!-- Measured by Generic.Metrics in phpcs.xml -->
        <exclude name="CyclomaticComplexity"/>
        <exclude name="NPathComplexity"/>
    </rule>

    <rule ref="rulesets/naming.xml">
        <!-- $id, $wp and $db are idiomatic in WordPress code; long descriptive names are WPCS style -->
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>
</ruleset>
